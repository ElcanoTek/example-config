{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "plugin_notes": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/server/plugin_notes.py"],
      "env": {
        "PLUGIN_NOTES_FILE": "${PLUGIN_DATA}/notes.jsonl"
      }
    }
  }
}
